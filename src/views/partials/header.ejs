<% const currentUser = locals.currentUser || null; const flash = locals.flash || null; %>
<!doctype html>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · SecureBook</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="topbar">
    <div class="wrap topbar-inner">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4.5" width="18" height="16.5" rx="3"/>
            <path d="M3 9.5h18M8 2.5v4M16 2.5v4"/>
            <path d="M8.5 15l2.5 2.5 4.5-4.5"/>
          </svg>
        </span>
        SecureBook
      </a>
      <nav class="nav">
        <% if (currentUser) { %>
          <% if (currentUser.role === 'admin') { %>
            <a href="/admin">Dashboard</a>
            <a href="/admin/slots">Schedule</a>
            <a href="/admin/users">Users</a>
            <a href="/admin/security">Security</a>
          <% } else { %>
            <a href="/slots">Book</a>
            <a href="/bookings">My bookings</a>
          <% } %>
          <a href="/profile">Profile</a>
          <form method="post" action="/logout" class="inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="link-button">Log out</button>
          </form>
        <% } else { %>
          <a href="/login">Log in</a>
          <a class="btn btn-small" href="/register">Register</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="wrap page">
    <% if (flash) { %>
      <div class="flash flash-<%= flash.type %>"><%= flash.text %></div>
    <% } %>
