<%- include('../partials/header') %>

<h1>Admin dashboard</h1>

<div class="stats">
  <div class="stat"><span class="stat-value"><%= stats.active_bookings %></span><span class="stat-label">Active bookings</span></div>
  <div class="stat"><span class="stat-value"><%= stats.cancelled_bookings %></span><span class="stat-label">Cancelled</span></div>
  <div class="stat"><span class="stat-value"><%= stats.customers %></span><span class="stat-label">Customers</span></div>
  <div class="stat"><span class="stat-value"><%= stats.upcoming_slots %></span><span class="stat-label">Upcoming slots</span></div>
</div>

<h2>All bookings</h2>
<div class="table-wrap">
  <table>
    <thead>
      <tr><th>Booking</th><th>Customer</th><th>Service</th><th>Date</th><th>Time</th><th>Notes</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
      <% bookings.forEach(function (b) { %>
        <tr>
          <td>#<%= b.id %></td>
          <td><%= b.customer_name %><br><span class="muted"><%= b.customer_phone %></span></td>
          <td><%= b.service_name %></td>
          <td><%= b.slot_date %></td>
          <td><%= b.start_time.slice(0, 5) %></td>
          <%# v1 baseline: notes are printed without HTML encoding (stored XSS, report 2.1.4.3) %>
          <td class="notes"><%- b.notes || '' %></td>
          <td><span class="status status-<%= b.status %>"><%= b.status %></span></td>
          <td>
            <% if (b.status === 'booked') { %>
              <form method="post" action="/admin/bookings/<%= b.id %>/cancel" class="inline">
                <button type="submit" class="btn btn-small btn-danger">Cancel</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
