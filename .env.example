# SecureBook environment settings — copy this file to ".env" and edit if needed.
#   Mac/Linux:  cp .env.example .env
#   Windows:    copy .env.example .env

# --- App ---
APP_HOST=localhost
HTTP_PORT=3000
HTTPS_PORT=3443

# --- Database (XAMPP default: user "root", empty password) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=securebook

# --- Session ---
# Must be at least 32 characters. Generate your own random string and paste it here.
# (Mac/Linux: run  openssl rand -hex 32  and copy the result.)
SESSION_SECRET=change-this-to-a-long-random-string-at-least-32-chars
